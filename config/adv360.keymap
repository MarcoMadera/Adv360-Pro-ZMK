#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        to_ly: to_ly {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_LY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        s_mm_quotes: s_mm_quotes {
            compatible = "zmk,behavior-mod-morph";
            label = "S_MM_QUOTES";
            bindings = <&to_ly 5 DOUBLE_QUOTES>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        b_e_letter: b_e_letter {
            compatible = "zmk,behavior-mod-morph";
            label = "B_E_LETTER";
            bindings = <&kp E>, <&kp LS(E)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        b_a_letter: b_a_letter {
            compatible = "zmk,behavior-mod-morph";
            label = "B_A_LETTER";
            bindings = <&kp A>, <&kp LS(A)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        b_i_letter: b_i_letter {
            compatible = "zmk,behavior-mod-morph";
            label = "B_I_LETTER";
            bindings = <&kp I>, <&kp LS(I)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        b_o_letter: b_o_letter {
            compatible = "zmk,behavior-mod-morph";
            label = "B_O_LETTER";
            bindings = <&kp O>, <&kp LS(O)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        b_u_letter: b_u_letter {
            compatible = "zmk,behavior-mod-morph";
            label = "B_U_LETTER";
            bindings = <&kp U>, <&kp LS(U)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_quotes_lin: mm_quotes_lin {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_QUOTES_LIN";
            bindings = <&mt RIGHT_ALT DOUBLE_QUOTES>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        ene: ene {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(N)>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>;

            label = "ENE";
        };

        letter_i: letter_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(E)>,
                <&macro_tap>,
                <&b_i_letter>,
                <&macro_release>;

            label = "LETTER_I";
        };

        letter_a: letter_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(E)>,
                <&macro_tap>,
                <&b_a_letter>,
                <&macro_release>;

            label = "LETTER_A";
        };

        letter_e: letter_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(E)>,
                <&macro_tap>,
                <&b_e_letter>,
                <&macro_release>;

            label = "LETTER_E";
        };

        letter_o: letter_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(E)>,
                <&macro_tap>,
                <&b_o_letter>,
                <&macro_release>;

            label = "LETTER_O";
        };

        letter_u: letter_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LA(E)>,
                <&macro_tap>,
                <&b_u_letter>,
                <&macro_release>;

            label = "LETTER_U";
        };

        apost: apost {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp SQT>,
                <&macro_tap>,
                <&kp U>,
                <&macro_release>;

            label = "APOST";
        };

        linux_profile_layer_1: linux_profile_layer_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&bt BT_SEL 2>,
                <&macro_tap>,
                <&to 6>,
                <&macro_release>;

            label = "LINUX_PROFILE_LAYER_1";
        };

        mac_profile_layer_1: mac_profile_layer_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&bt BT_SEL 1>,
                <&macro_tap>,
                <&to 0>,
                <&macro_release>;

            label = "MAC_PROFILE_LAYER_1";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL         &kp N1           &kp N2              &kp N3     &kp N4                      &kp N5              &tog 1                                                                  &mo 3             &kp N6  &kp N7  &kp N8     &kp N9    &kp N0          &kp MINUS
&kp TAB           &kp Q            &kp W               &kp E      &kp R                       &kp T               &tog 2                                                                  &tog 4            &kp Y   &kp U   &kp I      &kp O     &kp FSLH        &kp BSLH
&kp ESC           &hm LG(LCTRL) A  &hm LC(LEFT_ALT) S  &kp D      &hm LG(LA(LEFT_CONTROL)) F  &hm LG(LEFT_ALT) G  &kp CAPSLOCK  &kp LA(E)  &bl BL_TOG      &kp C_PREVIOUS     &kp C_NEXT  &kp C_PLAY_PAUSE  &kp H   &kp J   &kp K      &kp L     &kp P           &s_mm_quotes
&mo 7             &kp Z            &kp X               &kp C      &kp V                       &kp B                                        &bl BL_INC      &kp C_VOLUME_UP                                  &kp N   &kp M   &kp COMMA  &kp DOT   &hm COLON SEMI  &kp RSHFT
&kp LEFT_COMMAND  &kp LCTRL        &kp LEFT_ARROW      &kp RIGHT  &kp LEFT_ALT                                    &kp BSPC      &kp DEL    &bl BL_DEC      &kp C_VOLUME_DOWN  &kp ENTER   &kp SPACE                 &kp UP  &kp DOWN   &kp LBKT  &kp RBKT        &kp GRAVE
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                                            &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                            &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A   &kp S   &kp D   &kp F   &kp G   &trans    &trans   &trans      &trans  &trans     &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B                      &trans      &trans                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&trans     &trans  &trans  &trans  &trans          &kp BSPC  &kp DEL  &trans      &trans  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0            &mac_profile_layer_1  &linux_profile_layer_1  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &linux_profile_layer_1  &none                 &none                   &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none                   &none                 &none                   &none         &none         &trans       &none  &none      &bt BT_CLR  &none       &trans           &none  &none       &none       &none  &none  &none
&none           &none                   &none                 &none                   &trans        &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none                   &none                 &none                   &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        dfs_mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans  &trans                                            &trans      &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans  &trans                                            &trans      &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans  &trans     &trans  &trans      &trans  &trans     &kp C_MUTE  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans                     &trans      &trans                         &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &kp LEFT_WIN          &mkp RCLK  &trans  &trans      &trans  &mkp MCLK  &mkp LCLK                   &trans          &trans        &trans           &trans  &trans
            >;
        };

        int {
            bindings = <
&trans  &trans     &trans  &trans     &trans  &trans  &trans                                      &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans     &trans  &letter_e  &trans  &trans  &trans                                      &trans  &trans  &letter_u  &letter_i  &letter_o  &trans  &trans
&trans  &letter_a  &trans  &trans     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans     &trans  &trans     &trans  &trans                  &trans      &trans                  &ene    &trans     &trans     &trans     &trans  &trans
&trans  &trans     &trans  &trans     &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans     &trans     &trans     &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                        &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &hm LA(LC(LG(LEFT_SHIFT))) F  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mm_quotes_lin
&trans  &trans  &trans  &trans  &trans                        &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans      &trans      &trans      &trans  &trans                                      &trans     &trans  &kp KP_NUM       &kp KP_EQUAL  &kp KP_SLASH  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans      &trans      &trans      &trans  &trans                                      &trans     &trans  &kp KP_N7        &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &trans
&trans  &trans  &kp LC(F1)  &kp LC(F2)  &kp LC(F3)  &trans  &trans  &trans  &trans      &trans  &trans  &trans     &trans  &kp KP_NUMBER_4  &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &trans
&trans  &trans  &trans      &kp LC(F5)  &kp LC(F4)  &trans                  &trans      &trans                     &trans  &kp KP_N1        &kp KP_N2     &kp KP_N3     &kp KP_ENTER     &trans
&trans  &trans  &trans      &trans      &trans              &trans  &trans  &trans      &trans  &trans  &kp KP_N0          &trans           &trans        &kp KP_DOT    &trans           &trans
            >;
        };
    };
};
